{
  "name": "code-agent",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @code-agent/server",
    "start": "npm run build -w @code-agent/web && npm start -w @code-agent/server",
    "build": "npm run build -w @code-agent/web",
    "typecheck": "npm run typecheck -w @code-agent/shared && npm run typecheck -w @code-agent/server && npm run typecheck -w @code-agent/web",
    "test": "node --import tsx --test packages/shared/src/*.test.ts apps/server/src/*.test.ts apps/web/src/lib/*.test.ts"
  }
}
